# Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tefu_investment?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tefu_investment?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
PORT=4000
USER_ORIGIN=http://127.0.0.1:5173
ADMIN_ORIGIN=http://127.0.0.1:5174
CURRENCY=NGN

# Payments: demo | paystack
PAYMENTS_MODE=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional; defaults to PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
PUBLIC_API_URL=https://api.tefuinvestment.com
APP_FRONTEND_URL=https://tefuinvestment.com
USER_ORIGIN=https://tefuinvestment.com
ADMIN_ORIGIN=https://admin.tefuinvestment.com
# Legacy fallback used only in demo mode if Paystack is unset
PAYMENT_WEBHOOK_SECRET=

IDENTITY_MODE=otobill
OTOBILL_API_KEY=
OTOBILL_BASE_URL=https://api.otobill.com
EXPOSE_OTP=true
STORAGE_DIR=storage

# Per-user rate limits (set RATE_LIMIT_ENABLED=false to disable)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_USER=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MONEY_MAX=10
RATE_LIMIT_AUTH_MAX=20
