# Local: use your machine Postgres, or docker compose (postgresql://tefu:tefu@localhost:5432/tefu_investment)
DATABASE_URL=postgresql://tefu:tefu@localhost:5432/tefu_investment?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
PORT=4000
USER_ORIGIN=http://127.0.0.1:5173
ADMIN_ORIGIN=http://127.0.0.1:5174
CURRENCY=NGN
PAYMENTS_MODE=demo
PAYMENT_WEBHOOK_SECRET=replace-with-the-provider-webhook-secret
IDENTITY_MODE=otobill
OTOBILL_API_KEY=
OTOBILL_BASE_URL=https://api.otobill.com
EXPOSE_OTP=true
STORAGE_DIR=storage
