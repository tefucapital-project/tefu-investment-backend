generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserKind {
  CLIENT
  ADMIN
  CASHIER
  OPERATIONS
}

enum OpsGroupStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum GroupMembershipStatus {
  ACTIVE
  REMOVED
}

enum AnnouncementDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum CreditSource {
  CASH
  BANK_TRANSFER
  ADJUSTMENT
}

enum CreditRequestStatus {
  DRAFT
  PENDING_VERIFICATION
  PENDING_APPROVAL
  POSTED
  REJECTED
  FAILED
  REVERSED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum AdminRole {
  SUPER_ADMIN
  COMPLIANCE_ADMIN
  INVESTMENT_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  OPERATIONS_OFFICER
  OPERATIONS_SUPERVISOR
}

enum AccountStatus {
  REGISTERED
  OTP_PENDING
  OTP_VERIFIED
  KYC_LOCKED
  KYC_IN_PROGRESS
  KYC_PENDING_REVIEW
  KYC_APPROVED
  KYC_REJECTED
  KYC_UPDATE_REQUIRED
  ACTIVE
  SUSPENDED
}

enum CheckStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  REQUIRES_UPDATE
  COMPLETE
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
  REQUIRES_UPDATE
}

enum PayStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
  REFUNDED
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  REVERSED
}

enum OppStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  FUNDING
  FULLY_FUNDED
  ACTIVE
  LEASE_ACTIVE
  MATURED
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum HoldingStatus {
  PENDING
  ACTIVE
  MATURED
  COMPLETED
  SUSPENDED
}

enum DistributionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum ProductKind {
  MUDARABAH
  IJARAH
}

enum LedgerDirection {
  DEBIT
  CREDIT
  NEUTRAL
}

model User {
  id              String         @id @default(cuid()) @map("_id")
  kind            UserKind
  email           String         @unique
  phone           String?        @unique
  passwordHash    String
  firstName       String
  middleName      String         @default("")
  lastName        String
  role            AdminRole?
  accountStatus   AccountStatus  @default(OTP_PENDING)
  adminActive     Boolean        @default(true)
  failedLogins    Int            @default(0)
  lockedUntil     DateTime?
  referralCode    String?
  acceptedTerms   Boolean        @default(false)
  acceptedPrivacy Boolean        @default(false)
  pinHash         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  refreshTokens RefreshToken[]
  otps          OtpCode[]
  kyc           KycRecord?
  wallet        Wallet?
  fees          ClientFee[]
  payments      Payment[]
  withdrawals   Withdrawal[]
  holdings      Holding[]
  acceptances   AgreementAcceptance[]
  notifications Notification[]
  tickets       SupportTicket[]
  documents     Document[]
  auditAsActor       AuditLog[]           @relation("AuditActor")
  idempotency        IdempotencyRecord[]
  cashierProfile     CashierProfile?
  cashierShifts      CashierShift[]        @relation("CashierShiftOwner")
  creditRequests     CreditRequest[]      @relation("CreditInitiator")
  creditApprovals    CreditRequest[]      @relation("CreditApprover")
  cashierDeposits    CashierDeposit[]
  creditedCustomers  CreditRequest[]      @relation("CreditCustomer")
  groupMemberships   GroupMember[]        @relation("GroupClient")
  groupsCreated      UserGroup[]          @relation("GroupCreator")
  groupsCoordinated  UserGroup[]          @relation("GroupCoordinator")
  groupActivities    GroupActivityLog[]   @relation("GroupActivityStaff")
  groupAnnouncements GroupAnnouncement[]  @relation("GroupAnnouncementSender")
  ticketsAssigned    SupportTicket[]      @relation("TicketAssignee")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("refresh_tokens")
}

model OtpCode {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  purpose   String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("otp_codes")
}

model PasswordReset {
  id        String    @id @default(cuid()) @map("_id")
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@map("password_resets")
}

model Permission {
  name  String           @id @map("_id")
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id         String    @id @default(cuid()) @map("_id")
  role       AdminRole
  permission String
  grant      Permission @relation(fields: [permission], references: [name])

  @@unique([role, permission])
  @@map("role_permissions")
}

model KycRecord {
  id              String        @id @default(cuid()) @map("_id")
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id])
  status          AccountStatus @default(KYC_LOCKED)
  personalStatus  CheckStatus   @default(NOT_STARTED)
  ninStatus       CheckStatus   @default(NOT_STARTED)
  bvnStatus       CheckStatus   @default(NOT_STARTED)
  bankStatus      CheckStatus   @default(NOT_STARTED)
  documentStatus  CheckStatus   @default(NOT_STARTED)
  identityStatus  CheckStatus   @default(NOT_STARTED)
  dateOfBirth     String?
  gender          String?
  nationality     String?
  address         String?
  state           String?
  lga             String?
  ninLast4        String?
  ninHash         String?
  ninReference    String?
  bvnLast4        String?
  bvnHash         String?
  bvnReference    String?
  rejectionReason String?
  updateReason    String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bankAccounts BankAccount[]
  documents    Document[]

  @@map("kyc_records")
}

model BankAccount {
  id            String      @id @default(cuid()) @map("_id")
  kycId         String
  kyc           KycRecord   @relation(fields: [kycId], references: [id])
  bankName      String
  accountNumber String
  accountName   String
  status        CheckStatus @default(PENDING)
  reference     String?
  eligible      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@map("bank_accounts")
}

model Document {
  id         String     @id @default(cuid()) @map("_id")
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  kycId      String?
  kyc        KycRecord? @relation(fields: [kycId], references: [id])
  kind       String
  fileName   String
  storageKey String
  status     DocStatus  @default(PENDING)
  note       String?
  createdAt  DateTime   @default(now())

  @@map("documents")
}

model Wallet {
  id            String        @id @default(cuid()) @map("_id")
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id])
  currency      String
  availableKobo Int           @default(0)
  lockedKobo    Int           @default(0)
  balanceKobo   Int           @default(0)
  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now())
  entries       LedgerEntry[]

  @@map("wallets")
}

model LedgerEntry {
  id          String          @id @default(cuid()) @map("_id")
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id])
  reference   String          @unique
  type        String
  amountKobo  Int
  direction   LedgerDirection
  status      String
  description String
  createdAt   DateTime        @default(now())

  @@map("ledger_entries")
}

model FeeType {
  id       String  @id @default(cuid()) @map("_id")
  name     String  @unique
  mode     String
  amount   Int
  currency String
  active   Boolean @default(true)

  @@map("fee_types")
}

model ClientFee {
  id         String    @id @default(cuid()) @map("_id")
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  name       String
  amountKobo Int
  status     PayStatus @default(PENDING)
  reference  String    @unique
  provider   String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@map("client_fees")
}

model Payment {
  id         String           @id @default(cuid()) @map("_id")
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  purpose    String
  reference  String           @unique
  amountKobo Int
  status     PayStatus        @default(PENDING)
  provider   String
  applied    Boolean          @default(false)
  createdAt  DateTime         @default(now())
  paidAt     DateTime?
  webhooks   PaymentWebhook[]

  @@map("payments")
}

model PaymentWebhook {
  id        String   @id @default(cuid()) @map("_id")
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  eventKey  String   @unique
  payload   Json
  createdAt DateTime @default(now())

  @@map("payment_webhooks")
}

model Withdrawal {
  id            String           @id @default(cuid()) @map("_id")
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  bankAccountId String
  amountKobo    Int
  feeKobo       Int
  reference     String           @unique
  status        WithdrawalStatus @default(PENDING)
  reason        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("withdrawals")
}

model Opportunity {
  id             String    @id @default(cuid()) @map("_id")
  kind           ProductKind
  name           String
  summary        String
  status         OppStatus @default(DRAFT)
  minKobo        Int
  maxKobo        Int
  targetKobo     Int
  fundedKobo     Int       @default(0)
  durationMonths Int
  investorShare  Int       @default(70)
  risk           String
  shariah        String
  createdById    String
  approvedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  holdings       Holding[]

  @@map("opportunities")
}

model Holding {
  id            String             @id @default(cuid()) @map("_id")
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  opportunityId String
  opportunity   Opportunity        @relation(fields: [opportunityId], references: [id])
  amountKobo    Int
  feeKobo       Int
  reference     String             @unique
  status        HoldingStatus      @default(ACTIVE)
  maturesAt     DateTime
  createdAt     DateTime           @default(now())
  lines         DistributionLine[]

  @@map("holdings")
}

model Distribution {
  id              String             @id @default(cuid()) @map("_id")
  opportunityId   String
  kind            ProductKind
  performanceKobo Int
  status          DistributionStatus @default(DRAFT)
  reference       String             @unique
  preparedById    String
  approvedById    String?
  createdAt       DateTime           @default(now())
  lines           DistributionLine[]

  @@map("distributions")
}

model DistributionLine {
  id             String       @id @default(cuid()) @map("_id")
  distributionId String
  distribution   Distribution @relation(fields: [distributionId], references: [id])
  holdingId      String
  holding        Holding      @relation(fields: [holdingId], references: [id])
  amountKobo     Int
  applied        Boolean      @default(false)

  @@map("distribution_lines")
}

model Agreement {
  id          String                @id @default(cuid()) @map("_id")
  code        String
  title       String
  version     String
  body        String
  active      Boolean               @default(true)
  acceptances AgreementAcceptance[]

  @@unique([code, version])
  @@map("agreements")
}

model AgreementAcceptance {
  id          String    @id @default(cuid()) @map("_id")
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  holdingId   String?
  reference   String    @unique
  createdAt   DateTime  @default(now())

  @@map("agreement_acceptances")
}

model Notification {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}

model SupportTicket {
  id           String           @id @default(cuid()) @map("_id")
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  subject      String
  category     String           @default("GENERAL")
  priority     String           @default("NORMAL")
  status       String           @default("OPEN")
  assigneeId   String?
  assignee     User?            @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(cuid()) @map("_id")
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  authorId  String
  body      String
  staff     Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@map("support_messages")
}

model AuditLog {
  id           String   @id @default(cuid()) @map("_id")
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String
  reason       String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}

model IdempotencyRecord {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String
  response  Json
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@map("idempotency_records")
}

model SystemSetting {
  key   String @id @map("_id")
  value String

  @@map("system_settings")
}

model CashierProfile {
  id              String   @id @default(cuid()) @map("_id")
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  staffId         String   @unique
  branch          String   @default("Head Office")
  singleLimitKobo Int      @default(50000000)
  dailyLimitKobo  Int      @default(500000000)
  mfaEnabled      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cashier_profiles")
}

model CashierShift {
  id                String      @id @default(cuid()) @map("_id")
  cashierId         String
  cashier           User        @relation("CashierShiftOwner", fields: [cashierId], references: [id])
  status            ShiftStatus @default(OPEN)
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  openingFloatKobo  Int         @default(0)
  cashReceivedKobo  Int         @default(0)
  transferReceivedKobo Int      @default(0)
  postedCreditsKobo Int         @default(0)
  pendingCount      Int         @default(0)
  countedCashKobo   Int?
  varianceKobo      Int?
  varianceReason    String?
  closedNote        String?

  credits  CreditRequest[]
  deposits CashierDeposit[]

  @@map("cashier_shifts")
}

model CreditRequest {
  id                 String              @id @default(cuid()) @map("_id")
  reference          String              @unique
  idempotencyKey     String
  customerId         String
  customer           User                @relation("CreditCustomer", fields: [customerId], references: [id])
  cashierId          String
  cashier            User                @relation("CreditInitiator", fields: [cashierId], references: [id])
  approverId         String?
  approver           User?               @relation("CreditApprover", fields: [approverId], references: [id])
  shiftId            String?
  shift              CashierShift?       @relation(fields: [shiftId], references: [id])
  amountKobo         Int
  source             CreditSource
  externalReference  String
  purpose            String
  evidenceNote       String?
  status             CreditRequestStatus @default(PENDING_APPROVAL)
  ledgerReference    String?
  rejectionReason    String?
  postedAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([cashierId, idempotencyKey])
  @@unique([externalReference])
  @@map("credit_requests")
}

model CashierDeposit {
  id                String       @id @default(cuid()) @map("_id")
  reference         String       @unique
  customerId        String?
  cashierId         String
  cashier           User         @relation(fields: [cashierId], references: [id])
  shiftId           String?
  shift             CashierShift? @relation(fields: [shiftId], references: [id])
  amountKobo        Int
  method            CreditSource
  externalReference String       @unique
  note              String?
  verified          Boolean      @default(false)
  createdAt         DateTime     @default(now())

  @@map("cashier_deposits")
}

model UserGroup {
  id             String         @id @default(cuid()) @map("_id")
  name           String
  description    String         @default("")
  status         OpsGroupStatus @default(ACTIVE)
  coordinatorId  String?
  coordinator    User?          @relation("GroupCoordinator", fields: [coordinatorId], references: [id])
  createdById    String
  createdBy      User           @relation("GroupCreator", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  members        GroupMember[]
  activities     GroupActivityLog[]
  announcements  GroupAnnouncement[]

  @@map("user_groups")
}

model GroupMember {
  id         String                 @id @default(cuid()) @map("_id")
  groupId    String
  group      UserGroup              @relation(fields: [groupId], references: [id])
  clientId   String
  client     User                   @relation("GroupClient", fields: [clientId], references: [id])
  addedById  String
  status     GroupMembershipStatus  @default(ACTIVE)
  addedAt    DateTime               @default(now())
  removedAt  DateTime?

  @@unique([groupId, clientId])
  @@map("group_members")
}

model GroupActivityLog {
  id              String    @id @default(cuid()) @map("_id")
  groupId         String
  group           UserGroup @relation(fields: [groupId], references: [id])
  staffId         String
  staff           User      @relation("GroupActivityStaff", fields: [staffId], references: [id])
  action          String
  affectedMemberId String?
  note            String?
  createdAt       DateTime  @default(now())

  @@map("group_activity_logs")
}

model GroupAnnouncement {
  id              String                     @id @default(cuid()) @map("_id")
  groupId         String
  group           UserGroup                  @relation(fields: [groupId], references: [id])
  title           String
  message         String
  senderId        String
  sender          User                       @relation("GroupAnnouncementSender", fields: [senderId], references: [id])
  deliveryStatus  AnnouncementDeliveryStatus @default(PENDING)
  createdAt       DateTime                   @default(now())

  @@map("group_announcements")
}
